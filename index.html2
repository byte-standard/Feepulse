```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>FeePulse — Institute Fee &amp; Attendance Portal</title>
  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #115e59;
      --accent: #f59e0b;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --danger: #dc2626;
      --danger-bg: #fef2f2;
      --success: #059669;
      --success-bg: #ecfdf5;
      --warn: #d97706;
      --warn-bg: #fffbeb;
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
      min-height: 100vh;
    }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    .container { max-width: 840px; margin: 0 auto; padding: 12px 12px 88px; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 12px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .row { display: flex; align-items: center; gap: 8px; }
    .row-between { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .wrap { flex-wrap: wrap; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    @media (max-width: 560px) {
      .grid-3 { grid-template-columns: 1fr; }
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: #e2e8f0;
      color: #334155;
    }
    .badge-green { background: var(--success-bg); color: var(--success); }
    .badge-red { background: var(--danger-bg); color: var(--danger); }
    .badge-amber { background: var(--warn-bg); color: var(--warn); }
    .badge-blue { background: #eff6ff; color: #1d4ed8; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1px solid transparent;
      border-radius: 12px;
      padding: 9px 13px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: opacity 0.15s, transform 0.1s;
    }
    .btn:active { transform: scale(0.98); }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-sm { padding: 6px 10px; font-size: 12px; border-radius: 10px; }
    .btn-block { width: 100%; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-dark { background: #0f172a; color: #fff; }
    .btn-wa { background: #16a34a; color: #fff; }
    .btn-blast { background: linear-gradient(135deg, #059669 0%, #0f766e 100%); color: #fff; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.28); }
    .btn-danger { background: var(--danger-bg); color: var(--danger); border-color: #fecaca; }
    .btn-outline { background: #fff; color: #1e293b; border-color: #cbd5e1; }
    .btn-ghost { background: #f8fafc; color: #334155; border-color: #e2e8f0; }
    .input, .select, .textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 12px;
      border: 1.5px solid #cbd5e1;
      background: #f8fafc;
      color: #0f172a;
      font-size: 14px;
      outline: none;
    }
    .input:focus, .select:focus, .textarea:focus {
      border-color: var(--primary);
      background: #fff;
    }
    .pin-input {
      text-align: center;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 10px;
      padding: 11px;
    }
    label.lbl {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: #475569;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: #0f172a;
      color: #fff;
      padding: 10px 14px;
      border-bottom: 1px solid #1e293b;
    }
    .topbar-inner { max-width: 840px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--primary);
      color: #fff;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 25;
      background: #ffffff;
      border-top: 1px solid #cbd5e1;
      display: flex;
      justify-content: space-around;
      padding: 6px 4px;
      box-shadow: 0 -2px 10px rgba(15, 23, 42, 0.06);
    }
    .nav-btn {
      flex: 1;
      border: none;
      background: transparent;
      color: #64748b;
      font-size: 11px;
      font-weight: 700;
      padding: 6px 2px;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .nav-btn.active { color: var(--primary); background: #f0fdfa; }
    .kpi {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 10px;
    }
    .kpi-val { font-size: 19px; font-weight: 800; margin-top: 2px; }
    .kpi-lbl { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; }
    .pill-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
    .pill {
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid #cbd5e1;
      background: #fff;
      font-size: 12px;
      font-weight: 700;
      color: #334155;
      white-space: nowrap;
    }
    .pill.active { background: #0f172a; color: #fff; border-color: #0f172a; }
    .student-row {
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 11px;
      margin-bottom: 8px;
      background: #fff;
    }
    .student-row.absent { border-color: #fca5a5; background: #fef2f2; }
    .student-row.present { border-color: #a7f3d0; background: #f0fdf4; }
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.68);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }
    .modal-box {
      background: #fff;
      border-radius: 18px;
      width: 100%;
      max-width: 560px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 16px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.28);
    }
    .toast {
      position: fixed;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      background: #0f172a;
      color: #fff;
      padding: 10px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      z-index: 60;
      box-shadow: 0 8px 20px rgba(0,0,0,0.22);
      max-width: 92vw;
      text-align: center;
    }
    .login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }
    .login-card {
      width: 100%;
      max-width: 400px;
      background: #fff;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }
    .small { font-size: 12px; color: #64748b; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    pre.msg-box {
      white-space: pre-wrap;
      word-break: break-word;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 11px;
      font-size: 12.5px;
      font-family: inherit;
      margin: 8px 0;
    }
    .review-list {
      max-height: 210px;
      overflow-y: auto;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 6px;
      background: #f8fafc;
      margin: 8px 0;
    }
    .review-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 8px;
      border-radius: 9px;
      background: #fff;
      border: 1px solid #e2e8f0;
      margin-bottom: 5px;
      font-size: 12.5px;
    }
    .progress-bar-wrap {
      width: 100%;
      height: 10px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin: 8px 0;
    }
    .progress-bar-fill {
      height: 100%;
      background: #059669;
      transition: width 0.2s ease;
    }
  </style>
</head>
<body>
  <div id="app">
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:sans-serif;color:#334155;padding:20px;text-align:center;">
      <div>
        <div style="font-size:20px;font-weight:800;margin-bottom:6px;">Loading FeePulse Portal...</div>
        <div style="font-size:13px;color:#64748b;">If this screen stays visible, please ensure the entire index.html file was copied completely.</div>
      </div>
    </div>
  </div>
  <div id="modal"></div>
  <div id="toast" class="toast" style="display:none;"></div>

  <script>
    (function () {
      const STORAGE_KEY = 'feepulse_v2_data';
      let memStore = null;

      function readStorage() {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return memStore;
        }
      }

      function writeStorage(obj) {
        try {
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify(obj));
        } catch (e) {
          memStore = obj;
        }
      }

      function dateStr(offset) {
        const d = new Date();
        d.setDate(d.getDate() + (offset || 0));
        return d.toISOString().split('T')[0];
      }

      const TODAY = dateStr(0);
      const YESTERDAY = dateStr(-1);

      function buildInitialData() {
        return {
          adminSecretKey: 'SHIVA7799',
          masterPin: '1234',
          institutes: [
            {
              id: 'apex-nirmal',
              code: 'APEX1',
              name: 'Apex Coaching Academy',
              tagline: 'IIT-JEE, NEET & Board Foundation',
              city: 'Nirmal, Telangana',
              phone: '9848022334',
              upiId: 'apexacademy@okicici',
              pin: '1111',
              status: 'active',
              primaryColor: '#0f766e',
              logoUrl: '',
              lang: 'en-te',
              waMode: 'mobile',
              cloudApi: { phoneNumberId: '', accessToken: '', templateName: '' },
              classes: [
                { id: 'c1', name: '10th Board', sections: ['Morning A', 'Evening B'], defaultFee: 1800 },
                { id: 'c2', name: 'Inter 1st Yr MPC', sections: ['Section A', 'Section B'], defaultFee: 2800 },
                { id: 'c3', name: 'Inter 2nd Yr BiPC', sections: ['Morning Batch'], defaultFee: 3000 }
              ],
              students: [
                {
                  id: 's1', rollNo: '101', name: 'Karthikeya Rao', parent: 'Srinivas Rao', phone: '9849112233',
                  className: '10th Board', section: 'Morning A', status: 'active',
                  baseFee: 1800, busFee: 600, examFee: 350, certFee: 0,
                  discountType: 'flat', discountValue: 200, discountReason: 'Merit',
                  paidAmount: 1000, dueDate: TODAY, lastReceipt: 'Cash Rs.1000'
                },
                {
                  id: 's2', rollNo: '102', name: 'Keerthana Rao', parent: 'Srinivas Rao', phone: '9849112233',
                  className: 'Inter 1st Yr MPC', section: 'Section A', status: 'active',
                  baseFee: 2800, busFee: 600, examFee: 500, certFee: 150,
                  discountType: 'flat', discountValue: 300, discountReason: 'Sibling',
                  paidAmount: 3750, dueDate: TODAY, lastReceipt: 'UPI Full Paid'
                },
                {
                  id: 's3', rollNo: '103', name: 'Mohammed Ayaan', parent: 'Mohammed Irfan', phone: '9701334455',
                  className: '10th Board', section: 'Morning A', status: 'active',
                  baseFee: 1800, busFee: 0, examFee: 350, certFee: 0,
                  discountType: 'flat', discountValue: 0, discountReason: '',
                  paidAmount: 0, dueDate: YESTERDAY, lastReceipt: ''
                },
                {
                  id: 's4', rollNo: '104', name: 'Ananya Reddy', parent: 'Prabhakar Reddy', phone: '9989223344',
                  className: 'Inter 2nd Yr BiPC', section: 'Morning Batch', status: 'active',
                  baseFee: 3000, busFee: 700, examFee: 500, certFee: 200,
                  discountType: 'percent', discountValue: 10, discountReason: 'Topper 10%',
                  paidAmount: 2500, dueDate: TODAY, lastReceipt: 'Cash Rs.2500'
                },
                {
                  id: 's5', rollNo: '105', name: 'Sai Charan Goud', parent: 'Ramesh Goud', phone: '9440445566',
                  className: '10th Board', section: 'Evening B', status: 'active',
                  baseFee: 1800, busFee: 0, examFee: 350, certFee: 100,
                  discountType: 'flat', discountValue: 0, discountReason: '',
                  paidAmount: 2250, dueDate: TODAY, lastReceipt: 'UPI Full Paid'
                },
                {
                  id: 's6', rollNo: '106', name: 'Harshitha Devi', parent: 'Venkatesh Sharma', phone: '9177556677',
                  className: 'Inter 1st Yr MPC', section: 'Section B', status: 'active',
                  baseFee: 2800, busFee: 600, examFee: 500, certFee: 0,
                  discountType: 'flat', discountValue: 0, discountReason: '',
                  paidAmount: 1500, dueDate: YESTERDAY, lastReceipt: 'Part Cash Rs.1500'
                }
              ],
              attendance: {
                [TODAY]: { isHoliday: false, holidayReason: '', absentIds: ['s1', 's3'] },
                [YESTERDAY]: { isHoliday: false, holidayReason: '', absentIds: ['s4', 's6'] }
              },
              history: {
                [TODAY]: [
                  { time: '09:40 AM', type: 'Paid', student: 'Keerthana Rao', text: 'Paid Rs.3,750 via UPI (Settled)' }
                ],
                [YESTERDAY]: [
                  { time: '10:35 AM', type: 'Absent', student: 'Ananya Reddy', text: 'Absent alert sent to 9989223344' },
                  { time: '05:10 PM', type: 'Fee', student: 'Mohammed Ayaan', text: 'Fee reminder (Rs.2,150) sent' }
                ]
              },
              sentFlags: {}
            },
            {
              id: 'pragathi-kmm',
              code: 'PRAGATHI',
              name: 'Pragathi IIT & NEET Academy',
              tagline: 'Residential & Day Scholar Campus',
              city: 'Khammam, Telangana',
              phone: '9949011223',
              upiId: 'pragathikmm@ybl',
              pin: '2222',
              status: 'active',
              primaryColor: '#1d4ed8',
              logoUrl: '',
              lang: 'en-te',
              waMode: 'web',
              cloudApi: { phoneNumberId: '', accessToken: '', templateName: '' },
              classes: [
                { id: 'pc1', name: 'NEET Long Term', sections: ['Batch 1'], defaultFee: 3500 }
              ],
              students: [
                {
                  id: 'ps1', rollNo: '01', name: 'Aarav Varma', parent: 'Rajesh Varma', phone: '9848111222',
                  className: 'NEET Long Term', section: 'Batch 1', status: 'active',
                  baseFee: 3500, busFee: 500, examFee: 400, certFee: 0,
                  discountType: 'flat', discountValue: 400, discountReason: 'Early Bird',
                  paidAmount: 2000, dueDate: TODAY, lastReceipt: 'Cash Rs.2000'
                }
              ],
              attendance: {
                [TODAY]: { isHoliday: false, holidayReason: '', absentIds: ['ps1'] }
              },
              history: {},
              sentFlags: {}
            }
          ]
        };
      }

      let db = readStorage();
      if (!db || !Array.isArray(db.institutes)) {
        db = buildInitialData();
        writeStorage(db);
      }

      function saveDb() {
        writeStorage(db);
      }

      const urlParams = new URLSearchParams(window.location.search);
      const ui = {
        mode: urlParams.get('admin') === 'true' ? 'admin-gate' : 'login',
        instId: null,
        fromAdmin: false,
        lockTaps: 0,
        tab: 'overview',
        selectedDate: TODAY,
        rcClass: 'ALL',
        rcSection: 'ALL',
        rcSearch: '',
        feeFilter: 'ALL',
        feeSearch: '',
        scenarioType: 'exam',
        scenarioTarget: 'ALL',
        scenarioClass: 'ALL',
        scenarioText: 'Dear {parent}, Exam Fee / Hall Ticket notice for {student} ({class}). Pending due: Rs.{due}. Pay via UPI: {upi} - {inst}',
        revealedPins: {},
        showAdminCreds: false,
        bulkBatch: null
      };

      function toast(msg) {
        const el = document.getElementById('toast');
        if (!el) return;
        el.textContent = msg;
        el.style.display = 'block';
        clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(() => { el.style.display = 'none'; }, 3000);
      }

      function esc(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function cleanPhone(p) {
        const digits = String(p || '').replace(/\D/g, '');
        if (digits.length === 10) return '91' + digits;
        if (digits.length === 12 && digits.startsWith('91')) return digits;
        return digits;
      }

      function calcFee(st) {
        const gross = (Number(st.baseFee) || 0) + (Number(st.busFee) || 0) + (Number(st.examFee) || 0) + (Number(st.certFee) || 0);
        let disc = 0;
        if (st.discountType === 'percent') {
          disc = Math.round((gross * (Number(st.discountValue) || 0)) / 100);
        } else {
          disc = Number(st.discountValue) || 0;
        }
        const net = Math.max(0, gross - disc);
        const paid = Number(st.paidAmount) || 0;
        const due = Math.max(0, net - paid);
        return { gross, disc, net, paid, due };
      }

      function buildWaUrl(inst, phone, text) {
        const num = cleanPhone(phone);
        const encoded = encodeURIComponent(text);
        if (inst.waMode === 'web') {
          return 'https://web.whatsapp.com/send?phone=' + num + '&text=' + encoded;
        }
        return 'https://wa.me/' + num + '?text=' + encoded;
      }

      function buildAbsentMsg(inst, st, dateVal) {
        const en = 'Namaste ' + st.parent + ', your ward ' + st.name + ' (' + st.className + ') is marked ABSENT on ' + dateVal + ' at ' + inst.name + '. Call ' + inst.phone + ' if uninformed.';
        if (inst.lang === 'en-te') {
          return en + '\n\nనమస్కారం ' + st.parent + ', మీ పిల్లవాడు/పిల్ల ' + st.name + ' (' + st.className + ') ఈ రోజు (' + dateVal + ') ' + inst.name + ' కు గైర్హాజరయ్యారు.';
        }
        if (inst.lang === 'en-hi') {
          return en + '\n\nनमस्ते ' + st.parent + ', आपका बच्चा ' + st.name + ' (' + st.className + ') आज (' + dateVal + ') ' + inst.name + ' में अनुपस्थित है।';
        }
        return en;
      }

      function buildFeeMsg(inst, st) {
        const f = calcFee(st);
        const upiLink = 'upi://pay?pa=' + encodeURIComponent(inst.upiId || '') + '&pn=' + encodeURIComponent(inst.name) + '&am=' + f.due + '&c
